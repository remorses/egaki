{
  "name": "@egaki/angled-screen",
  "version": "0.0.1",
  "type": "module",
  "description": "Turn a flat screenshot into a tilted 3D screen with depth of field. WebGL2 renderer plus a CLI that renders through your Chrome.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": "dist/cli.js",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./src": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./src/*": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/remorses/egaki.git",
    "directory": "angled-screen"
  },
  "homepage": "https://github.com/remorses/egaki#readme",
  "bugs": {
    "url": "https://github.com/remorses/egaki/issues"
  },
  "files": [
    "src",
    "dist",
    "skills"
  ],
  "keywords": [
    "screenshot",
    "mockup",
    "3d",
    "perspective",
    "depth-of-field",
    "bokeh",
    "webgl",
    "shader",
    "cli",
    "playwriter"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/cli.js",
    "prepublishOnly": "rimraf dist \"*.tsbuildinfo\" && pnpm build"
  },
  "license": "MIT",
  "dependencies": {
    "goke": "^6.14.1",
    "playwriter": "^0.10.0",
    "string-dedent": "^3.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^25.3.0",
    "rimraf": "^6.0.1"
  }
}
