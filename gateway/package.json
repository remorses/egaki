{
  "name": "egaki-gateway",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "sigillo run -c dev -- wrangler dev",
    "typecheck": "tsc",
    "types": "wrangler types",
    "deploy": "tsc && wrangler deploy --env preview",
    "deploy:prod": "tsc && wrangler deploy",
    "secrets": "sigillo secrets download -c prod --format env | wrangler secret bulk --env=\"\"",
    "secrets:preview": "sigillo secrets download -c preview --format env | wrangler secret bulk --env preview"
  },
  "dependencies": {
    "@strada.sh/sdk": "^0.5.0",
    "hono": "^4.7.10",
    "resend": "^6.8.0",
    "stripe": "^20.2.0"
  },
  "devDependencies": {
    "@ai-sdk/provider": "3.0.8",
    "typescript": "^5.9.3",
    "wrangler": "^4.105.0"
  }
}
