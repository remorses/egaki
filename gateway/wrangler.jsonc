{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "egaki-gateway",
  "main": "src/worker.ts",
  "compatibility_date": "2026-06-29",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,

  // Cloudflare runtime tracing (KV, R2, fetch, handler spans). Works alongside
  // the Strada SDK: built-in tracing gives automatic spans, the SDK gives
  // error capture and structured logs.
  "observability": {
    "traces": { "enabled": true }
  },

  // Strada project ID is public — it only identifies which project telemetry
  // belongs to. The ingest token is a secret (see "secrets" below).
  "vars": {
    "STRADA_PROJECT_ID": "01KYP8AMJF2MX4VYRK2RTRACJH",
    "ENVIRONMENT": "production"
  },

  // Declared secrets are typed as `string` on the global Env by `wrangler
  // types`, and `wrangler deploy` refuses to deploy when one is unset.
  // Values are managed in Sigillo and uploaded with `pnpm secrets`.
  "secrets": {
    "required": [
      "AI_GATEWAY_API_KEY",
      "STRIPE_SECRET_KEY",
      "STRIPE_WEBHOOK_SECRET",
      "RESEND_API_KEY",
      "RESEND_FROM",
      "STRADA_TOKEN"
    ]
  },

  // KV Namespace for API keys, usage, subscriptions
  "kv_namespaces": [
    {
      "binding": "EGAKI_KV",
      "id": "a0846afcec1340028742d97bc32b9023"
    }
  ],

  // R2 bucket for temporary file uploads (2-day lifecycle expiration)
  "r2_buckets": [
    {
      "binding": "EGAKI_UPLOADS",
      "bucket_name": "egaki-uploads"
    }
  ],

  // Rate limiting for upload endpoint (30 requests per 60 seconds per IP)
  "unsafe": {
    "bindings": [
      {
        "name": "RATE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "0",
        "simple": { "period": 60, "limit": 30 }
      }
    ]
  },

  // Path routes for the API on egaki.org. The docs website worker (website/)
  // owns the egaki.org custom domain as fallback; these more-specific path
  // routes take precedence over the custom domain, so the published CLI URLs
  // (https://egaki.org/v3/ai, /upload, /buy, ...) keep working unchanged.
  "routes": [
    { "pattern": "egaki.org/v3/*", "zone_name": "egaki.org" },
    { "pattern": "egaki.org/api/*", "zone_name": "egaki.org" },
    { "pattern": "egaki.org/upload", "zone_name": "egaki.org" },
    { "pattern": "egaki.org/uploads/*", "zone_name": "egaki.org" },
    { "pattern": "egaki.org/buy*", "zone_name": "egaki.org" },
    { "pattern": "egaki.org/success*", "zone_name": "egaki.org" },
    { "pattern": "egaki.org/stripe/*", "zone_name": "egaki.org" }
  ],

  "env": {
    "preview": {
      "name": "egaki-gateway-preview",
      "routes": [],
      "observability": {
        "traces": { "enabled": true }
      },
      "vars": {
        "STRADA_PROJECT_ID": "01KYP8AMJF2MX4VYRK2RTRACJH",
        "ENVIRONMENT": "preview"
      },
      "secrets": {
        "required": [
          "AI_GATEWAY_API_KEY",
          "STRIPE_SECRET_KEY",
          "STRIPE_WEBHOOK_SECRET",
          "RESEND_API_KEY",
          "RESEND_FROM",
          "STRADA_TOKEN"
        ]
      },
      "kv_namespaces": [
        {
          "binding": "EGAKI_KV",
          "id": "29ab987dff8d4612b4c96fab00c6d850"
        }
      ],
      "r2_buckets": [
        {
          "binding": "EGAKI_UPLOADS",
          "bucket_name": "egaki-uploads-preview"
        }
      ],
      "unsafe": {
        "bindings": [
          {
            "name": "RATE_LIMITER",
            "type": "ratelimit",
            "namespace_id": "1",
            "simple": { "period": 60, "limit": 30 }
          }
        ]
      }
    }
  }
}
