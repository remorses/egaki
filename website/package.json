{
  "name": "egaki-website",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "sigillo run -c dev -- vite dev",
    "generate-cli-docs": "tsx scripts/generate-cli-docs.ts",
    "build": "pnpm generate-cli-docs && tsc && vite build",
    "start": "sigillo run -c dev -- node dist/rsc/index.js",
    "deploy": "CLOUDFLARE_ENV=preview pnpm build && wrangler deploy --env preview",
    "deploy:prod": "pnpm build && wrangler deploy",
    "secrets": "sigillo secrets download -c prod --format env | wrangler secret bulk --env=\"\"",
    "secrets:preview": "sigillo secrets download -c preview --format env | wrangler secret bulk --env preview",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@holocron.so/vite": "^0.33.0",
    "@strada.sh/sdk": "^0.5.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "spiceflow": "1.26.0-rsc.18",
    "vite": "^8.0.10"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.0.14",
    "@types/react": "^19.2.17",
    "egaki": "workspace:^",
    "goke": "^6.14.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.105.0"
  }
}
