{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "strict": true,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    // vite/client provides import.meta.hot, used to disable Strada ingest
    // during local dev. Cloudflare runtime types come from
    // worker-configuration.d.ts (generated by `wrangler types`), included below.
    "types": ["vite/client"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "scripts/**/*.ts",
    "worker-configuration.d.ts"
  ]
}
